{
  "_comment": "match: вся строка должна быть ровно одним токеном (expect = имя токена или null = отказ/ловушка). tokens: поток токенов maximal munch, WS/COMMENT отброшены (если не keep_skip), ERROR = символ попал в ловушку из старта.",

  "match": [
    {"group": "empty",       "input": "",            "expect": null},

    {"group": "whitespace",  "input": " ",           "expect": "WS"},
    {"group": "whitespace",  "input": "    ",        "expect": "WS"},
    {"group": "whitespace",  "input": "\t",          "expect": "WS"},
    {"group": "whitespace",  "input": "\t\t\t",      "expect": "WS"},
    {"group": "whitespace",  "input": " \t \t",      "expect": "WS"},
    {"group": "whitespace",  "input": "\n",          "expect": "WS"},
    {"group": "whitespace",  "input": "\r",          "expect": "WS"},
    {"group": "whitespace",  "input": "\r\n",        "expect": "WS"},
    {"group": "whitespace",  "input": "\r\n\r\n",    "expect": "WS"},
    {"group": "whitespace",  "input": " \t\r\n \t",  "expect": "WS"},
    {"group": "whitespace",  "input": "\f",          "expect": null},
    {"group": "whitespace",  "input": "\u000b",      "expect": null},

    {"group": "integers",    "input": "0",           "expect": "INT"},
    {"group": "integers",    "input": "00",          "expect": "BAD_INT"},
    {"group": "integers",    "input": "01",          "expect": "BAD_INT"},
    {"group": "integers",    "input": "000",         "expect": "BAD_INT"},
    {"group": "integers",    "input": "0123",        "expect": "BAD_INT"},
    {"group": "integers",    "input": "1",           "expect": "INT"},
    {"group": "integers",    "input": "10",          "expect": "INT"},
    {"group": "integers",    "input": "100",         "expect": "INT"},
    {"group": "integers",    "input": "9876543210",  "expect": "INT"},
    {"group": "integers",    "input": "-1",          "expect": null},
    {"group": "integers",    "input": "1a",          "expect": null},
    {"group": "integers",    "input": "1_000",       "expect": null},

    {"group": "identifiers", "input": "x",               "expect": "IDENT"},
    {"group": "identifiers", "input": "_",               "expect": null},
    {"group": "identifiers", "input": "__",              "expect": null},
    {"group": "identifiers", "input": "_x",              "expect": null},
    {"group": "identifiers", "input": "x_",              "expect": null},
    {"group": "identifiers", "input": "_1",              "expect": null},
    {"group": "identifiers", "input": "a1_b2",           "expect": null},
    {"group": "identifiers", "input": "snake_case_name", "expect": null},
    {"group": "identifiers", "input": "__init__",        "expect": null},
    {"group": "identifiers", "input": "CamelCase",       "expect": "IDENT"},
    {"group": "identifiers", "input": "ZZ_99",           "expect": null},
    {"group": "identifiers", "input": "x1",              "expect": "IDENT"},
    {"group": "identifiers", "input": "abc123",          "expect": "IDENT"},
    {"group": "identifiers", "input": "A",               "expect": "IDENT"},
    {"group": "identifiers", "input": "camelCase9",      "expect": "IDENT"},
    {"group": "identifiers", "input": "1x",              "expect": null},
    {"group": "identifiers", "input": "a-b",             "expect": null},
    {"group": "identifiers", "input": "a b",             "expect": null},

    {"group": "keywords",    "input": "function",   "expect": "KW_FUNCTION"},
    {"group": "keywords",    "input": "returns",    "expect": "KW_RETURNS"},
    {"group": "keywords",    "input": "while",      "expect": "KW_WHILE"},
    {"group": "keywords",    "input": "if",         "expect": "KW_IF"},
    {"group": "keywords",    "input": "else",       "expect": "KW_ELSE"},
    {"group": "keywords",    "input": "assert",     "expect": "KW_ASSERT"},
    {"group": "keywords",    "input": "assume",     "expect": "KW_ASSUME"},
    {"group": "keywords",    "input": "invariant",  "expect": "KW_INVARIANT"},
    {"group": "keywords",    "input": "length",     "expect": "KW_LENGTH"},
    {"group": "keywords",    "input": "requires",   "expect": "KW_REQUIRES"},
    {"group": "keywords",    "input": "ensures",    "expect": "KW_ENSURES"},
    {"group": "keywords",    "input": "uses",       "expect": "KW_USES"},
    {"group": "keywords",    "input": "int",        "expect": "KW_INT"},
    {"group": "keywords",    "input": "true",       "expect": "KW_TRUE"},
    {"group": "keywords",    "input": "false",      "expect": "KW_FALSE"},
    {"group": "keywords",    "input": "not",        "expect": "KW_NOT"},
    {"group": "keywords",    "input": "and",        "expect": "KW_AND"},
    {"group": "keywords",    "input": "or",         "expect": "KW_OR"},
    {"group": "keywords",    "input": "forall",     "expect": "KW_FORALL"},
    {"group": "keywords",    "input": "exists",     "expect": "KW_EXISTS"},
    {"group": "keywords",    "input": "integer",    "expect": "IDENT"},
    {"group": "keywords",    "input": "in",         "expect": "IDENT"},
    {"group": "keywords",    "input": "ints",       "expect": "IDENT"},
    {"group": "keywords",    "input": "andor",      "expect": "IDENT"},
    {"group": "keywords",    "input": "o",          "expect": "IDENT"},
    {"group": "keywords",    "input": "nothing",    "expect": "IDENT"},
    {"group": "keywords",    "input": "True",       "expect": "IDENT"},
    {"group": "keywords",    "input": "falsey",     "expect": "IDENT"},
    {"group": "keywords",    "input": "use",        "expect": "IDENT"},
    {"group": "keywords",    "input": "ensure",     "expect": "IDENT"},
    {"group": "keywords",    "input": "forall1",    "expect": "IDENT"},
    {"group": "keywords",    "input": "exist",      "expect": "IDENT"},
    {"group": "keywords",    "input": "functions",  "expect": "IDENT"},
    {"group": "keywords",    "input": "func",       "expect": "IDENT"},
    {"group": "keywords",    "input": "return",     "expect": "IDENT"},
    {"group": "keywords",    "input": "returns_",   "expect": null},
    {"group": "keywords",    "input": "i",          "expect": "IDENT"},
    {"group": "keywords",    "input": "iff",        "expect": "IDENT"},
    {"group": "keywords",    "input": "If",         "expect": "IDENT"},
    {"group": "keywords",    "input": "IF",         "expect": "IDENT"},
    {"group": "keywords",    "input": "elsewhere",  "expect": "IDENT"},
    {"group": "keywords",    "input": "_while",     "expect": null},
    {"group": "keywords",    "input": "while1",     "expect": "IDENT"},
    {"group": "keywords",    "input": "assum",      "expect": "IDENT"},
    {"group": "keywords",    "input": "asserts",    "expect": "IDENT"},
    {"group": "keywords",    "input": "invariants", "expect": "IDENT"},
    {"group": "keywords",    "input": "len",        "expect": "IDENT"},
    {"group": "keywords",    "input": "lengths",    "expect": "IDENT"},

    {"group": "operators",   "input": "(",   "expect": "LPAREN"},
    {"group": "operators",   "input": ")",   "expect": "RPAREN"},
    {"group": "operators",   "input": "[",   "expect": "LBRACKET"},
    {"group": "operators",   "input": "]",   "expect": "RBRACKET"},
    {"group": "operators",   "input": "{",   "expect": "LBRACE"},
    {"group": "operators",   "input": "}",   "expect": "RBRACE"},
    {"group": "operators",   "input": ",",   "expect": "COMMA"},
    {"group": "operators",   "input": ";",   "expect": "SEMI"},
    {"group": "operators",   "input": "+",   "expect": "PLUS"},
    {"group": "operators",   "input": "-",   "expect": "MINUS"},
    {"group": "operators",   "input": "*",   "expect": "STAR"},
    {"group": "operators",   "input": "/",   "expect": "SLASH"},
    {"group": "operators",   "input": "==",  "expect": "EQ"},
    {"group": "operators",   "input": "!=",  "expect": "NE"},
    {"group": "operators",   "input": "<=",  "expect": "LE"},
    {"group": "operators",   "input": ">=",  "expect": "GE"},
    {"group": "operators",   "input": "<",   "expect": "LT"},
    {"group": "operators",   "input": ">",   "expect": "GT"},
    {"group": "operators",   "input": "=",   "expect": "ASSIGN"},
    {"group": "operators",   "input": "!",   "expect": null},
    {"group": "operators",   "input": "===", "expect": null},
    {"group": "operators",   "input": "=<",  "expect": null},
    {"group": "operators",   "input": "=>",  "expect": "FAT_ARROW"},
    {"group": "operators",   "input": "->",  "expect": "ARROW"},
    {"group": "operators",   "input": ":",   "expect": "COLON"},
    {"group": "operators",   "input": "|",   "expect": "BAR"},
    {"group": "operators",   "input": "-->", "expect": null},
    {"group": "operators",   "input": "||",  "expect": null},
    {"group": "operators",   "input": "::",  "expect": null},
    {"group": "operators",   "input": "→",   "expect": null},
    {"group": "operators",   "input": "<>",  "expect": null},
    {"group": "operators",   "input": "++",  "expect": null},
    {"group": "operators",   "input": "+=",  "expect": null},
    {"group": "operators",   "input": "&&",  "expect": null},

    {"group": "comments",    "input": "//",                    "expect": "COMMENT"},
    {"group": "comments",    "input": "// hello",              "expect": "COMMENT"},
    {"group": "comments",    "input": "//no space",            "expect": "COMMENT"},
    {"group": "comments",    "input": "/// triple",            "expect": "COMMENT"},
    {"group": "comments",    "input": "// a // b",             "expect": "COMMENT"},
    {"group": "comments",    "input": "//\t tab",              "expect": "COMMENT"},
    {"group": "comments",    "input": "// if while 00 @#$ !",  "expect": "COMMENT"},
    {"group": "comments",    "input": "//x\n",                 "expect": null},
    {"group": "comments",    "input": "//x\r",                 "expect": null},
    {"group": "comments",    "input": "/ /",                   "expect": null},

    {"group": "trap",        "input": "é",          "expect": null},
    {"group": "trap",        "input": "привет",     "expect": null},
    {"group": "trap",        "input": "€",          "expect": null},
    {"group": "trap",        "input": "😀",         "expect": null},
    {"group": "trap",        "input": "\u00a0",     "expect": null},
    {"group": "trap",        "input": "xé",         "expect": null},
    {"group": "trap",        "input": "1é",         "expect": null},
    {"group": "trap",        "input": "//é",        "expect": null},
    {"group": "trap",        "input": "@",          "expect": null},
    {"group": "trap",        "input": "#",          "expect": null},
    {"group": "trap",        "input": "$",          "expect": null},
    {"group": "trap",        "input": "`",          "expect": null},
    {"group": "trap",        "input": "~",          "expect": null},
    {"group": "trap",        "input": "\\",         "expect": null},
    {"group": "trap",        "input": "\"",         "expect": null},
    {"group": "trap",        "input": "'",          "expect": null},
    {"group": "trap",        "input": "\u0000",     "expect": null},
    {"group": "trap",        "input": "\u007f",     "expect": null}
  ],

  "tokens": [
    {"group": "empty", "name": "пустой вход", "input": "", "expect": []},

    {"group": "whitespace", "name": "только пробелы", "input": "     ", "expect": []},
    {"group": "whitespace", "name": "только табы",    "input": "\t\t\t", "expect": []},
    {"group": "whitespace", "name": "только CRLF",    "input": "\r\n\r\n", "expect": []},
    {"group": "whitespace", "name": "смесь",          "input": " \t\r\n \t\r\n", "expect": []},
    {"group": "whitespace", "name": "keep_skip", "keep_skip": true, "input": " x\t\r\n",
     "expect": [["WS", " "], ["IDENT", "x"], ["WS", "\t\r\n"]]},

    {"group": "integers", "name": "0 00 01", "input": "0 00 01",
     "expect": [["INT", "0"], ["BAD_INT", "00"], ["BAD_INT", "01"]]},
    {"group": "integers", "name": "0;", "input": "0;", "expect": [["INT", "0"], ["SEMI", ";"]]},
    {"group": "integers", "name": "несколько", "input": "10 0 7",
     "expect": [["INT", "10"], ["INT", "0"], ["INT", "7"]]},
    {"group": "integers", "name": "минус не часть числа", "input": "-0",
     "expect": [["MINUS", "-"], ["INT", "0"]]},
    {"group": "integers", "name": "0x1", "input": "0x1",
     "expect": [["INT", "0"], ["IDENT", "x1"]]},
    {"group": "integers", "name": "число+идентификатор", "input": "123abc",
     "expect": [["INT", "123"], ["IDENT", "abc"]]},

    {"group": "identifiers", "name": "подчёркивание запрещено спецификацией", "input": "_tmp1 = x_2",
     "expect": [["ERROR", "_"], ["IDENT", "tmp1"], ["ASSIGN", "="], ["IDENT", "x"], ["ERROR", "_"],
                ["INT", "2"]]},
    {"group": "identifiers", "name": "_ внутри имени", "input": "snake_case",
     "expect": [["IDENT", "snake"], ["ERROR", "_"], ["IDENT", "case"]]},
    {"group": "identifiers", "name": "буквы и цифры", "input": "a1 B2c3 x",
     "expect": [["IDENT", "a1"], ["IDENT", "B2c3"], ["IDENT", "x"]]},

    {"group": "keywords", "name": "все ключевые слова",
     "input": "function returns while if else assert assume invariant length",
     "expect": [["KW_FUNCTION", "function"], ["KW_RETURNS", "returns"], ["KW_WHILE", "while"],
                ["KW_IF", "if"], ["KW_ELSE", "else"], ["KW_ASSERT", "assert"],
                ["KW_ASSUME", "assume"], ["KW_INVARIANT", "invariant"], ["KW_LENGTH", "length"]]},
    {"group": "keywords", "name": "префиксы/суффиксы", "input": "if iff ifx _if",
     "expect": [["KW_IF", "if"], ["IDENT", "iff"], ["IDENT", "ifx"], ["ERROR", "_"], ["KW_IF", "if"]]},
    {"group": "keywords", "name": "ключевые слова из спецификации",
     "input": "requires ensures uses int true false not and or forall exists",
     "expect": [["KW_REQUIRES", "requires"], ["KW_ENSURES", "ensures"], ["KW_USES", "uses"],
                ["KW_INT", "int"], ["KW_TRUE", "true"], ["KW_FALSE", "false"], ["KW_NOT", "not"],
                ["KW_AND", "and"], ["KW_OR", "or"], ["KW_FORALL", "forall"], ["KW_EXISTS", "exists"]]},
    {"group": "keywords", "name": "int[]", "input": "a: int[]",
     "expect": [["IDENT", "a"], ["COLON", ":"], ["KW_INT", "int"], ["LBRACKET", "["], ["RBRACKET", "]"]]},
    {"group": "keywords", "name": "слитно", "input": "functionreturns",
     "expect": [["IDENT", "functionreturns"]]},
    {"group": "keywords", "name": "цифра перед if", "input": "1if",
     "expect": [["INT", "1"], ["KW_IF", "if"]]},

    {"group": "operators", "name": "разделители", "input": "()[]{},;",
     "expect": [["LPAREN", "("], ["RPAREN", ")"], ["LBRACKET", "["], ["RBRACKET", "]"],
                ["LBRACE", "{"], ["RBRACE", "}"], ["COMMA", ","], ["SEMI", ";"]]},
    {"group": "operators", "name": "арифметика", "input": "+-*/",
     "expect": [["PLUS", "+"], ["MINUS", "-"], ["STAR", "*"], ["SLASH", "/"]]},
    {"group": "operators", "name": "сравнения слитно", "input": "a==b!=c<=d>=e<f>g=h",
     "expect": [["IDENT", "a"], ["EQ", "=="], ["IDENT", "b"], ["NE", "!="], ["IDENT", "c"],
                ["LE", "<="], ["IDENT", "d"], ["GE", ">="], ["IDENT", "e"], ["LT", "<"],
                ["IDENT", "f"], ["GT", ">"], ["IDENT", "g"], ["ASSIGN", "="], ["IDENT", "h"]]},
    {"group": "operators", "name": "===", "input": "===", "expect": [["EQ", "=="], ["ASSIGN", "="]]},
    {"group": "operators", "name": "<==", "input": "<==", "expect": [["LE", "<="], ["ASSIGN", "="]]},
    {"group": "operators", "name": "!=!", "input": "!=!", "expect": [["NE", "!="], ["ERROR", "!"]]},
    {"group": "operators", "name": "импликация", "input": "a->b",
     "expect": [["IDENT", "a"], ["ARROW", "->"], ["IDENT", "b"]]},
    {"group": "operators", "name": "минус и импликация", "input": "a-->b x-1",
     "expect": [["IDENT", "a"], ["MINUS", "-"], ["ARROW", "->"], ["IDENT", "b"], ["IDENT", "x"],
                ["MINUS", "-"], ["INT", "1"]]},
    {"group": "operators", "name": "=> vs >= vs ==", "input": "=>>===",
     "expect": [["FAT_ARROW", "=>"], ["GE", ">="], ["EQ", "=="]]},
    {"group": "operators", "name": "стрелка → вне ASCII", "input": "p → q",
     "expect": [["IDENT", "p"], ["ERROR", "→"], ["IDENT", "q"]]},
    {"group": "operators", "name": "одиночный !", "input": "!x",
     "expect": [["ERROR", "!"], ["IDENT", "x"]]},

    {"group": "comments", "name": "деление vs комментарий", "input": "a = b / c // comment",
     "expect": [["IDENT", "a"], ["ASSIGN", "="], ["IDENT", "b"], ["SLASH", "/"], ["IDENT", "c"]]},
    {"group": "comments", "name": "до конца строки (LF и CRLF)", "input": "x // c1\ny // c2\r\nz",
     "expect": [["IDENT", "x"], ["IDENT", "y"], ["IDENT", "z"]]},
    {"group": "comments", "name": "только комментарий", "input": "// only comment", "expect": []},
    {"group": "comments", "name": "два комментария", "input": "//a\n//b", "expect": []},
    {"group": "comments", "name": "/ / — не комментарий", "input": "a/ /b",
     "expect": [["IDENT", "a"], ["SLASH", "/"], ["SLASH", "/"], ["IDENT", "b"]]},
    {"group": "comments", "name": "keep_skip", "keep_skip": true, "input": "x//c\n",
     "expect": [["IDENT", "x"], ["COMMENT", "//c"], ["WS", "\n"]]},
    {"group": "comments", "name": "CRLF + 00", "input": "x = 1 // tail\r\ny = 00",
     "expect": [["IDENT", "x"], ["ASSIGN", "="], ["INT", "1"], ["IDENT", "y"], ["ASSIGN", "="],
                ["BAD_INT", "00"]]},

    {"group": "trap", "name": "ASCII вне языка", "input": "a @ b",
     "expect": [["IDENT", "a"], ["ERROR", "@"], ["IDENT", "b"]]},
    {"group": "trap", "name": "non-ASCII в выражении", "input": "x = é;",
     "expect": [["IDENT", "x"], ["ASSIGN", "="], ["ERROR", "é"], ["SEMI", ";"]]},
    {"group": "trap", "name": "non-ASCII в комментарии", "input": "//é",
     "expect": [["ERROR", "é"]]},
    {"group": "trap", "name": "non-ASCII внутри идентификатора", "input": "abécd",
     "expect": [["IDENT", "ab"], ["ERROR", "é"], ["IDENT", "cd"]]},
    {"group": "trap", "name": "NBSP", "input": "ab\u00a0cd",
     "expect": [["IDENT", "ab"], ["ERROR", "\u00a0"], ["IDENT", "cd"]]},
    {"group": "trap", "name": "кириллица", "input": "да",
     "expect": [["ERROR", "д"], ["ERROR", "а"]]},
    {"group": "trap", "name": "эмодзи", "input": "x😀y",
     "expect": [["IDENT", "x"], ["ERROR", "😀"], ["IDENT", "y"]]},
    {"group": "trap", "name": "NUL", "input": "x\u0000",
     "expect": [["IDENT", "x"], ["ERROR", "\u0000"]]},
    {"group": "trap", "name": "смесь мусора", "input": "a#b$c",
     "expect": [["IDENT", "a"], ["ERROR", "#"], ["IDENT", "b"], ["ERROR", "$"], ["IDENT", "c"]]},

    {"group": "program", "name": "пример gcd из спецификации",
     "input": "gcd(x: int, y: int)\n  returns r: int\n  uses a: int, b: int  // local variable declarations\n",
     "expect": [["IDENT", "gcd"], ["LPAREN", "("], ["IDENT", "x"], ["COLON", ":"], ["KW_INT", "int"],
                ["COMMA", ","], ["IDENT", "y"], ["COLON", ":"], ["KW_INT", "int"], ["RPAREN", ")"],
                ["KW_RETURNS", "returns"], ["IDENT", "r"], ["COLON", ":"], ["KW_INT", "int"],
                ["KW_USES", "uses"], ["IDENT", "a"], ["COLON", ":"], ["KW_INT", "int"], ["COMMA", ","],
                ["IDENT", "b"], ["COLON", ":"], ["KW_INT", "int"]]},
    {"group": "program", "name": "контракт с квантором",
     "input": "sum(a: int[]) requires forall(i: int | a[i] >= 0) returns s: int ensures s >= 0 and not false",
     "expect": [["IDENT", "sum"], ["LPAREN", "("], ["IDENT", "a"], ["COLON", ":"], ["KW_INT", "int"],
                ["LBRACKET", "["], ["RBRACKET", "]"], ["RPAREN", ")"], ["KW_REQUIRES", "requires"],
                ["KW_FORALL", "forall"], ["LPAREN", "("], ["IDENT", "i"], ["COLON", ":"], ["KW_INT", "int"],
                ["BAR", "|"], ["IDENT", "a"], ["LBRACKET", "["], ["IDENT", "i"], ["RBRACKET", "]"],
                ["GE", ">="], ["INT", "0"], ["RPAREN", ")"], ["KW_RETURNS", "returns"], ["IDENT", "s"],
                ["COLON", ":"], ["KW_INT", "int"], ["KW_ENSURES", "ensures"], ["IDENT", "s"], ["GE", ">="],
                ["INT", "0"], ["KW_AND", "and"], ["KW_NOT", "not"], ["KW_FALSE", "false"]]},
    {"group": "program", "name": "формула",
     "input": "pos(x: int) => x > 0 or exists(y: int | y == x) -> true",
     "expect": [["IDENT", "pos"], ["LPAREN", "("], ["IDENT", "x"], ["COLON", ":"], ["KW_INT", "int"],
                ["RPAREN", ")"], ["FAT_ARROW", "=>"], ["IDENT", "x"], ["GT", ">"], ["INT", "0"],
                ["KW_OR", "or"], ["KW_EXISTS", "exists"], ["LPAREN", "("], ["IDENT", "y"], ["COLON", ":"],
                ["KW_INT", "int"], ["BAR", "|"], ["IDENT", "y"], ["EQ", "=="], ["IDENT", "x"],
                ["RPAREN", ")"], ["ARROW", "->"], ["KW_TRUE", "true"]]},
    {"group": "program", "name": "max",
     "input": "function max(a, b) returns m {\n  if (a >= b) { m = a; } else { m = b; }\n}\n",
     "expect": [["KW_FUNCTION", "function"], ["IDENT", "max"], ["LPAREN", "("], ["IDENT", "a"],
                ["COMMA", ","], ["IDENT", "b"], ["RPAREN", ")"], ["KW_RETURNS", "returns"],
                ["IDENT", "m"], ["LBRACE", "{"], ["KW_IF", "if"], ["LPAREN", "("], ["IDENT", "a"],
                ["GE", ">="], ["IDENT", "b"], ["RPAREN", ")"], ["LBRACE", "{"], ["IDENT", "m"],
                ["ASSIGN", "="], ["IDENT", "a"], ["SEMI", ";"], ["RBRACE", "}"],
                ["KW_ELSE", "else"], ["LBRACE", "{"], ["IDENT", "m"], ["ASSIGN", "="],
                ["IDENT", "b"], ["SEMI", ";"], ["RBRACE", "}"], ["RBRACE", "}"]]},
    {"group": "program", "name": "цикл с инвариантом",
