// Euclid's algorithm: requires/ensures/uses, while with invariant, if/else
gcd(x: int, y: int)
  requires x > 0 and y > 0
  returns r: int
  ensures r > 0
  uses a: int, b: int
{
  a = x;
  b = y;
  while (a != b)
    invariant a > 0 and b > 0
  {
    if (a > b)
      a = a - b;
    else
      b = b - a;
  }
  r = a;
}
