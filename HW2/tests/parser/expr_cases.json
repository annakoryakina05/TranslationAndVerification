{
  "_comment": "mode: expr — целое выражение, cond — условие if/while, pred — предикат. expect: S-выражение или {\"error\": \"подстрока первой ошибки\"}.",
  "cases": [
    {"mode": "expr", "input": "a + b * c",           "expect": "(+ a (* b c))"},
    {"mode": "expr", "input": "a * b + c",           "expect": "(+ (* a b) c)"},
    {"mode": "expr", "input": "(a + b) * c",         "expect": "(* (+ a b) c)"},
    {"mode": "expr", "input": "a - b - c",           "expect": "(- (- a b) c)"},
    {"mode": "expr", "input": "a / b / c",           "expect": "(/ (/ a b) c)"},
    {"mode": "expr", "input": "a - b + c",           "expect": "(+ (- a b) c)"},
    {"mode": "expr", "input": "a * b / c * d",       "expect": "(* (/ (* a b) c) d)"},
    {"mode": "expr", "input": "-a * b",              "expect": "(* (neg a) b)"},
    {"mode": "expr", "input": "-a + -b",             "expect": "(+ (neg a) (neg b))"},
    {"mode": "expr", "input": "- -a",                "expect": "(neg (neg a))"},
    {"mode": "expr", "input": "a - -b",              "expect": "(- a (neg b))"},
    {"mode": "expr", "input": "-(a + b)",            "expect": "(neg (+ a b))"},
    {"mode": "expr", "input": "((((a))))",           "expect": "a"},
    {"mode": "expr", "input": "42",                  "expect": "42"},
    {"mode": "expr", "input": "0",                   "expect": "0"},
    {"mode": "expr", "input": "f()",                 "expect": "(call f)"},
    {"mode": "expr", "input": "f(a, b + 1, g(c))",   "expect": "(call f a (+ b 1) (call g c))"},
    {"mode": "expr", "input": "a[i + 1] * 2",        "expect": "(* (index a (+ i 1)) 2)"},
    {"mode": "expr", "input": "a[b[i]]",             "expect": "(index a (index b i))"},
    {"mode": "expr", "input": "length(a) - 1",       "expect": "(- (call length a) 1)"},
    {"mode": "expr", "input": "x1 + Y2z",            "expect": "(+ x1 Y2z)"},

    {"mode": "cond", "input": "a < b",                         "expect": "(< a b)"},
    {"mode": "cond", "input": "a + 1 <= b * 2",                "expect": "(<= (+ a 1) (* b 2))"},
    {"mode": "cond", "input": "a == b",                        "expect": "(== a b)"},
    {"mode": "cond", "input": "a != b",                        "expect": "(!= a b)"},
    {"mode": "cond", "input": "a >= b",                        "expect": "(>= a b)"},
    {"mode": "cond", "input": "a > b",                         "expect": "(> a b)"},
    {"mode": "cond", "input": "true",                          "expect": "true"},
    {"mode": "cond", "input": "false or true",                 "expect": "(or false true)"},
    {"mode": "cond", "input": "a < b and c < d or e < f",      "expect": "(or (and (< a b) (< c d)) (< e f))"},
    {"mode": "cond", "input": "a < b or c < d and e < f",      "expect": "(or (< a b) (and (< c d) (< e f)))"},
    {"mode": "cond", "input": "true and false and true",       "expect": "(and (and true false) true)"},
    {"mode": "cond", "input": "true or false or true",         "expect": "(or (or true false) true)"},
    {"mode": "cond", "input": "not a < b and c < d",           "expect": "(and (not (< a b)) (< c d))"},
    {"mode": "cond", "input": "not not true",                  "expect": "(not (not true))"},
    {"mode": "cond", "input": "not (a < b and c < d)",         "expect": "(not (and (< a b) (< c d)))"},
    {"mode": "cond", "input": "a < b -> c < d -> e < f",       "expect": "(-> (< a b) (-> (< c d) (< e f)))"},
    {"mode": "cond", "input": "a < b or c < d -> e < f",       "expect": "(-> (or (< a b) (< c d)) (< e f))"},
    {"mode": "cond", "input": "(true -> false) -> true",       "expect": "(-> (-> true false) true)"},
    {"mode": "cond", "input": "(a + b) > c",                   "expect": "(> (+ a b) c)"},
    {"mode": "cond", "input": "(a > b) and (b > c)",           "expect": "(and (> a b) (> b c))"},
    {"mode": "cond", "input": "((a > b))",                     "expect": "(> a b)"},
    {"mode": "cond", "input": "-a < -(b)",                     "expect": "(< (neg a) (neg b))"},

    {"mode": "pred", "input": "forall(i: int | a[i] >= 0)",            "expect": "(forall (i int) (>= (index a i) 0))"},
    {"mode": "pred", "input": "exists(a: int[] | length(a) == 0)",    "expect": "(exists (a int[]) (== (call length a) 0))"},
    {"mode": "pred", "input": "p(x) and q(y, 1)",                     "expect": "(and (formula p x) (formula q y 1))"},
    {"mode": "pred", "input": "not p(x)",                             "expect": "(not (formula p x))"},
    {"mode": "pred", "input": "f(x) > 0 and p(f(x))",                 "expect": "(and (> (call f x) 0) (formula p (call f x)))"},
    {"mode": "pred", "input": "forall(i: int | exists(j: int | i < j))", "expect": "(forall (i int) (exists (j int) (< i j)))"},
    {"mode": "pred", "input": "forall(i: int | i > 0) -> true",        "expect": "(-> (forall (i int) (> i 0)) true)"},
    {"mode": "pred", "input": "x > 0",                                 "expect": "(> x 0)"},

    {"mode": "expr", "input": "",              "expect": {"error": "ожидалось выражение, найдено конец файла"}},
    {"mode": "expr", "input": "a +",           "expect": {"error": "ожидалось выражение, найдено конец файла"}},
    {"mode": "expr", "input": "a b",           "expect": {"error": "лишний токен после выражения"}},
    {"mode": "expr", "input": "(a + b",        "expect": {"error": "ожидалось ')' для '(' из 1:1"}},
    {"mode": "expr", "input": "a + b)",        "expect": {"error": "лишний токен после выражения: ')'"}},
    {"mode": "expr", "input": "f(a b)",        "expect": {"error": "ожидалось ')' или ','"}},
    {"mode": "expr", "input": "a[1",           "expect": {"error": "ожидалось ']'"}},
    {"mode": "expr", "input": "a ** b",        "expect": {"error": "ожидалось выражение, найдено '*'"}},
    {"mode": "expr", "input": "a % b",         "expect": {"error": "недопустимый символ '%'"}},
    {"mode": "expr", "input": "+a",            "expect": {"error": "ожидалось выражение, найдено '+'"}},
    {"mode": "expr", "input": "a < b",         "expect": {"error": "ожидалось целочисленное выражение, найдено: сравнение"}},
    {"mode": "expr", "input": "true",          "expect": {"error": "ожидалось целочисленное выражение"}},
    {"mode": "expr", "input": "a + (b > c)",   "expect": {"error": "ожидалось целочисленное выражение"}},
    {"mode": "expr", "input": "f(a < b)",      "expect": {"error": "ожидалось целочисленное выражение"}},
    {"mode": "cond", "input": "a < b < c",     "expect": {"error": "сравнения нельзя записывать цепочкой"}},
    {"mode": "cond", "input": "a == b == c",   "expect": {"error": "сравнения нельзя записывать цепочкой"}},
    {"mode": "cond", "input": "a",             "expect": {"error": "ожидалось логическое выражение"}},
    {"mode": "cond", "input": "a + 1",         "expect": {"error": "ожидалось логическое выражение"}},
    {"mode": "cond", "input": "not a",         "expect": {"error": "ожидалось логическое выражение"}},
    {"mode": "cond", "input": "a < b and c",   "expect": {"error": "ожидалось логическое выражение"}},
    {"mode": "cond", "input": "p(x)",          "expect": {"error": "ссылки на формулы допустимы только в предикатах"}},
    {"mode": "cond", "input": "forall(i: int | i > 0)", "expect": {"error": "квантор 'forall' допустим только в предикатах"}},
    {"mode": "cond", "input": "a => b",        "expect": {"error": "лишний токен после выражения: '=>'"}},
    {"mode": "cond", "input": "a < b ->",      "expect": {"error": "ожидалось выражение, найдено конец файла"}},
    {"mode": "cond", "input": "a and and b",   "expect": {"error": "ожидалось выражение, найдено 'and'"}},
    {"mode": "pred", "input": "forall(i int | i > 0)", "expect": {"error": "ожидалось ':'"}},
    {"mode": "pred", "input": "forall(i: int, i > 0)", "expect": {"error": "ожидалось '|'"}},
    {"mode": "pred", "input": "forall(i: int | i > 0", "expect": {"error": "ожидалось ')' для '(' из 1:7"}},
    {"mode": "pred", "input": "forall i: int | i > 0", "expect": {"error": "ожидалось '(' после 'forall'"}},
    {"mode": "pred", "input": "exists(i: bool | true)", "expect": {"error": "ожидалось 'int'"}},
    {"mode": "pred", "input": "forall(i: int | i)", "expect": {"error": "ожидалось логическое выражение"}}
  ]
}
