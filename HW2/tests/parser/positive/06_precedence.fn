// Operator precedence and associativity
calc(a: int, b: int, c: int) returns r: int {
  r = a + b * c;
  r = (a + b) * c;
  r = a - b - c;
  r = a / b / c;
  r = -a * b;
  r = - -a;
  r = a - -b;
  r = a * (b - c) / -(a + 1);
  if (a < b and b < c or c == 0) r = 1;
  if (not a < b and b != c) r = 2;
  if (a < b -> b < c -> c < a) r = 3;
  if (a < b or b < c -> c > 0) r = 4;
  if ((a + b) > c) r = 5;
  if ((a > b) and (b > c)) r = 6;
  if (not not false) r = 7;
}
