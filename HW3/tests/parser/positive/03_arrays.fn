// Arrays: int[], length, read a[i], update b[i] = ... (store sugar)
copyInc(a: int[])
  returns b: int[]
  uses i: int
{
  b = a;
  i = 0;
  while (i < length(a)) invariant i >= 0 and i <= length(a) {
    b[i] = a[i] + 1;
    i = i + 1;
  }
}

sum(a: int[]) returns s: int uses i: int {
  s = 0;
  i = 0;
  while (i < length(a)) {
    s = s + a[i * 2 - 1];
    i = i + 1;
  }
}
