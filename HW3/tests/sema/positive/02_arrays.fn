// Arrays: int[] params/returns, a[i], length, element update (store sugar)
incAll(a: int[])
  requires length(a) > 0
  returns b: int[]
  ensures length(b) == length(a)
  uses i: int
{
  b = a;
  i = 0;
  while (i < length(a)) invariant i >= 0 and i <= length(b) {
    b[i] = a[i] + 1;
    i = i + 1;
  }
}

first(a: int[]) requires length(a) > 0 returns x: int x = a[0];
