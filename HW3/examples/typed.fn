// Types are checked; locals i and acc have no annotation, their types are inferred
positive(x: int) => x > 0

sum(a: int[])
  requires length(a) > 0 and forall(k: int | k >= 0 and k < length(a) -> positive(a[k]))
  returns s: int
  ensures s > 0
  uses i, acc
{
  i = 0;
  acc = 0;
  while (i < length(a)) invariant i >= 0 and i <= length(a) {
    acc = acc + a[i];
    i = i + 1;
  }
  s = acc;
}
